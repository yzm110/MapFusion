template<typename LineT>
bool PointBetweenLines(const LineT& line1, const LineT& line2, const float x,
                       const float y) {
  bool between = false;
  if (line1.size() < 2 || line2.size() < 2) return between;
  int c = 0;  
  auto CrossInOneSide =
      [](const float &c_x, const float &c_y,
      const float &n_x, const float &n_y,
      const float &x, const float &y) -> bool {
        return ((n_y < y && y <= c_y) || (c_y <= y && y < n_y))
            && x < c_x+(n_x-c_x)*(y-c_y)/(n_y-c_y);
      };
  for (int n = 1; n < line1.size(); ++n) {  
    c = n-1;  
    if (CrossInOneSide(line1[c].x, line1[c].y, line1[n].x, line1[n].y, x, y)) {
      between = !between;
    }
  }
  if (CrossInOneSide(line1.back().x, line1.back().y, line2.back().x,
                     line2.back().y, x, y)) {
    between = !between;
  }
  for (int n = line2.size()-2; n >= 0; --n) {  
    c = n+1;  
    if (CrossInOneSide(line2[c].x, line2[c].y, line2[n].x, line2[n].y, x, y)) {
      between = !between;
    }
  }
  if (CrossInOneSide(line2.front().x, line2.front().y, line1.front().x,
                     line1.front().y, x, y)) {
    between = !between;
  }
  return between;
}


template<typename LineT>
bool PointBetweenLinesByBox(const LineT& line1, const LineT& line2,
                            const std::vector<Point3D<float>> bbox) {
  for (const auto point : bbox) {
    int i = 0;
    if (PointBetweenLines(line1, line2, point.x, point.y)) {
      return true;
    }
  }
  return false;
}


template <typename T>
void GetIntervalIndexByS(const std::vector<T>& points, const float s,
                         int* const i_1st, int* const i_2nd,
                         float* const weight = NULL,
                         int* const i_start = NULL) {
  if (points.size() < 2) return;
  if (!i_start) {
    *i_2nd = std::upper_bound(points.begin(), points.end(), s,
                              [](const float s, const T& point) -> bool {
                                return s < point.s;
                              }) -
             points.begin();
    if (*i_2nd <= 0) {
      ++*i_2nd;
    } else if (*i_2nd >= points.size()) {
      --*i_2nd;
    }
    *i_1st = *i_2nd - 1;
  } else if (*i_start + 1 >= points.size()) {
    *i_start = *i_1st = points.size() - 2;
    *i_2nd = *i_1st + 1;
  } else {
    *i_2nd = *i_start + 1;
    while (*i_2nd < (points.size() - 1) && points.at(*i_2nd).s <= s) {
      ++*i_2nd;
    }
    *i_start = *i_1st = *i_2nd - 1;
  }
  if (weight) {
    *weight =
        (s - points.at(*i_1st).s) / (points.at(*i_2nd).s - points.at(*i_1st).s);
  }
}


template <typename T>
void GetIntervalIndexByT(const std::vector<T>& points, const float t,
                         int* const i_1st, int* const i_2nd,
                         float* const weight = NULL,
                         int* const i_start = NULL) {
  if (points.size() < 2) return;
  if (!i_start) {
    *i_2nd = std::upper_bound(points.begin(), points.end(), t,
                              [](const float t, const T& point) -> bool {
                                return t < point.t;
                              }) -
             points.begin();
    if (*i_2nd <= 0) {
      ++*i_2nd;
    } else if (*i_2nd >= points.size()) {
      --*i_2nd;
    }
    *i_1st = *i_2nd - 1;
  } else if (*i_start + 1 >= points.size()) {
    *i_start = *i_1st = points.size() - 2;
    *i_2nd = *i_1st + 1;
  } else {
    *i_2nd = *i_start + 1;
    while (*i_2nd < (points.size() - 1) && points.at(*i_2nd).t <= t) {
      ++*i_2nd;
    }
    *i_start = *i_1st = *i_2nd - 1;
  }
  if (weight) {
    *weight =
        (t - points.at(*i_1st).t) / (points.at(*i_2nd).t - points.at(*i_1st).t);
  }
}

template <typename T>
void GetIntervalIndexByXY(const std::vector<T>& points, const float x,
                          const float y, const float* yaw, int* const i_1st,
                          int* const i_2nd, float* const weight = NULL,
                          int* const i_start = NULL) {
  if (points.size() < 2) return;
  int min_i = (i_start ? *i_start : 0);
  min_i = std::max(min_i, 0);
  min_i = std::min(min_i, static_cast<int>(points.size() - 2));
  float min_distance =
      PointLineDistanceSquare(points[min_i].x, points[min_i].y,
                              points[min_i + 1].x, points[min_i + 1].y, x, y);
  for (int i = min_i + 1; i < static_cast<int>(points.size() - 1); ++i) {
    float tmp_distance = PointLineDistanceSquare(
        points[i].x, points[i].y, points[i + 1].x, points[i + 1].y, x, y);
    if (tmp_distance < min_distance &&
        (yaw == NULL ||
         (yaw != NULL &&
          fabs(unify_theta(*yaw - points.at(i).yaw)) < 0.25 * M_PI))) {
      min_distance = tmp_distance;
      min_i = i;
    }
  }
  *i_1st = min_i;
  *i_2nd = *i_1st + 1;
  if (i_start != NULL) {
    *i_start = *i_1st;
  }
  if (weight != NULL) {
    float theta = std::atan2(points.at(*i_2nd).y-points.at(*i_1st).y,
                             points.at(*i_2nd).x-points.at(*i_1st).x);
    float dx = x - points.at(*i_1st).x, dy = y - points.at(*i_1st).y;
    float projection = dx*std::cos(theta) + dy*std::sin(theta);
    float length = Distance(points.at(*i_1st).x, points.at(*i_1st).y,
                            points.at(*i_2nd).x, points.at(*i_2nd).y);
    *weight = length < 0.00001f ? 0.0f : projection / length;
    if (*i_1st != 0) {
      *weight = std::max(*weight, 0.0f);
    }
    if (*i_2nd+1 != points.size()) {
      *weight = std::min(*weight, 1.0f);
    }
  }
}

template<typename T>
class Line: public std::vector<T> {
 public:
  Line() : length_(0.0f) {};
  explicit Line(const size_t size) : length_(0.0f) {this->resize(size);}
  Line(const size_t size, const T& value) {
    this->resize(size);
    for_each(this->begin(), this->end(),
        [value](T& t){t = value;});
  }
  Line(const Line<T>& line) : length_(0.0f) {
    this->assign(line.begin(), line.end());
  }
  Line(Line<T>&& line) : length_(0.0f) {swap(line);}
  ~Line() = default;

  void ReInit() { Init(); }
  float Length() const { return this->length_; }

  Line<T>& operator= (const Line<T>& line) {
    this->assign(line.begin(), line.end());
    return *this;
  }
  Line<T>& operator= (Line<T>&& line) {
    this->swap(line);
      return *this;
  }
  
  bool XYToSL(const float x, const float y, const float* yaw, float* const s,
              float* const l, int* const i_start = nullptr) const {
    if (this->size() <= 1) {
      return false;
    }
    int i_1st, i_2nd;
    float weight;
    GetIntervalIndexByXY(*this, x, y, yaw, &i_1st, &i_2nd, &weight, i_start);
    auto ref_p = LinearInterpolationPoint(this->at(i_1st),
                                          this->at(i_2nd), weight);
    *s = ref_p.s;
    CartesianToFrenet(ref_p.x, ref_p.y, ref_p.yaw, x, y, l);
    return true;
  }

  bool XYToSL(const float x, const float y, const float v, const float a,
              const float yaw, float* const s,
              float* const l, std::array<float, 3>* ptr_s_condition,
              std::array<float, 3>* const ptr_l_condition) const {
    if (this->size() <= 1) {
      return false;
    }
    int i_1st, i_2nd;
    float weight;
    GetIntervalIndexByXY(*this, x, y, NULL, &i_1st, &i_2nd, &weight);
    auto ref_p =
        LinearInterpolationPoint(this->at(i_1st), this->at(i_2nd), weight);
    *s = ref_p.s;
    
    CartesianToFrenet(ref_p.s, ref_p.x, ref_p.y, ref_p.yaw, 0.0, 0.0, x, y, v,
                      a, yaw, 0.0, ptr_s_condition, ptr_l_condition);
    *l = (*ptr_l_condition)[0];
    return true;
  }

  T GetReferPoint(const float s) const {
    if (accumulated_s_.empty()) {
      return T();
    }

    if (s < accumulated_s_.front() - 1e-2f)
      return this->front();
    if (s > accumulated_s_.back() + 1e-2f)
      return this->back();
    auto interpolate_pair = GetIndexFromS(s);
    size_t index = interpolate_pair.first;
    size_t next_index = index + 1;
    if (next_index >= accumulated_s_.size()) {
      next_index = accumulated_s_.size() - 1;
    }
    const float s0 = accumulated_s_[index];
    const float s1 = accumulated_s_[next_index];
    if (std::fabs(s1 - s0) <= 1e-5f) {
      return this->at(index);
    }
    float weight =
        index != next_index ? interpolate_pair.second / (s1 - s0) : 1.0;
    weight = std::fmin(1.0f, std::fmax(0.0f, weight));

    return LinearInterpolationPoint(this->at(index), this->at(next_index),
                                    weight);
  }

  void RegenerateSortedAccumulatedS() {
    if (this->empty())
      return;
    accumulated_s_.resize(this->size());
    for (int i = 0; i < this->size(); ++i) {
      accumulated_s_[i] = this->at(i).s;
    }
  }

 private:
  float length_;
  std::vector<float> accumulated_s_;

  void Init() {
    if (this->size() <= 1) {
      length_ = 0.0f;
      return;
    }
    length_ = 0.0f;
    accumulated_s_.clear();
    this->at(0).s = length_;
    accumulated_s_.emplace_back(length_);
    for (int i = 1; i < this->size(); ++i) {
      length_ += Distance(this->at(i - 1).x, this->at(i - 1).y, this->at(i).x,
                          this->at(i).y);
      accumulated_s_.emplace_back(length_);
      this->at(i).s = length_;
    }
  }

  
  std::pair<int, float> GetIndexFromS(float s) const {
    if (accumulated_s_.empty() || s < accumulated_s_.front() - 1e-5f)
      return { 0, 0.0f };
    if (s > accumulated_s_.back())
      return { accumulated_s_.size() - 1, 0.0f };

    int index = std::distance(
        accumulated_s_.begin(),
        std::lower_bound(accumulated_s_.begin(), accumulated_s_.end(), s));
    if (accumulated_s_[index] > s)
      index = index - 1;
    return {index, s - accumulated_s_[index]};
  }
};  

enum class LinePosition {
  LINE_POSITION_UNKNOWN = 0,
  LINE_POSITION_LEFT = 1,
  LINE_POSITION_RIGHT = 2,
  LINE_POSITION_LEFT_LEFT = 3,
  LINE_POSITION_RIGHT_RIGHT = 4,
  LINE_POSITION_LEFT_N = 5,
  LINE_POSITION_RIGHT_N = 6
};

enum class LineModel {
  LINE_MODEL_RAW = 0,
  LINE_MODEL_ROAD = 1,
  LINE_MODEL_POAL = 2,
  LINE_MODEL_ROAD_UNPARALLEL = 3
};

enum class SideType {
  SIDE_TYPE_UNKNOWN = 0,
  SIDE_TYPE_ROAD = 1,
  SIDE_TYPE_FENCE = 2,
  SIDE_TYPE_CONE = 3
};

enum class LineDiversion {
  LINE_DIVERSION_UNKNOWN = 0,
  LINE_DIVERSION_INSIDE = 1,
  LINE_DIVERSION_OUTSIDE = 2
};

enum class LineType {
  LINE_TYPE_UNKNOWN = 0,
  LINE_TYPE_DASH = 1,
  LINE_TYPE_SOLID = 2,
  LINE_TYPE_DOUBLE_DASH = 3,
  LINE_TYPE_DOUBLE_SOLID = 4,
  LINE_TYPE_DASH_SOLID = 5,
  LINE_TYPE_SOLID_DASH = 6,
  LINE_TYPE_DASH_FISH_BONES = 7,
  LINE_TYPE_SOLID_FISH_BONES = 8,
  LINE_TYPE_DIVERSION = 9,
  LINE_TYPE_VIRTUAL = 10,
  LINE_TYPE_SHORT_DASH = 11
};

enum class MergeDirection {
  MERGE_DIRECTION_UNKNOWN = 0,
  MERGE_DIRECTION_LEFT = 1,
  MERGE_DIRECTION_MIDDLE = 2,
  MERGE_DIRECTION_RIGHT = 3
};

struct PairSLineType {
  float s;
  LineType type;
};

struct PairSV {
  float s;
  float min_v;
  float max_v;
};

struct PairSId {
  float s{0};
  std::string id{""};
  MergeDirection merge_dir{MergeDirection::MERGE_DIRECTION_UNKNOWN};
};

struct LineParams {
  std::string tag;
  std::vector<float> coeffs;
  float start_x;
  float end_x;
  float width;
};

struct TrafficLine {
    TrafficLine();
    TrafficLine(const TrafficLine& traffic_line);
    TrafficLine(TrafficLine&& traffic_line);
    ~TrafficLine() = default;
    void Initialize();
    void Reset(const TrafficLine& traffic_line);
    void Reset(TrafficLine&& traffic_line) noexcept;
    TrafficLine& operator= (const TrafficLine& traffic_line);
    TrafficLine& operator= (TrafficLine&& traffic_line);
    // TimeStamp time_stamp;
    std::string id;
    // ColorType color;
    std::vector<PairSLineType> types;
    std::vector<LineParams> line_params;
    bool changable;
    bool is_ramp;
    bool has_outer;
    int index;
    // DataSource source;
    std::string line_source;
    SideType side_type;
    LineModel model;
    LineDiversion line_diversion;
    Line<LinePoint<float>> line;
    bool make_up;
    uint8_t conf;  

    
    LineType type;
    LineType type_sense;
    
    
    std::vector<std::pair<float, float>> virtual_line_s;  
    float f_params(float x) {
      if (line_params.size() == 0) {
        return std::numeric_limits<float>::max();
      }
      if (x <= line_params.front().start_x) {
        return f(line_params.front().coeffs, x);
      } else {
        for (auto &param : line_params) {
          if (x >= param.start_x && x <= param.end_x) {
            return f(param.coeffs, x);
          }
        }
      }
      return f(line_params.back().coeffs, x);
    }
    float f(std::vector<float> &coeffs, float x) {
      float y = coeffs[0];
      float tmp = x;
      for (size_t d = 1; d < coeffs.size(); ++d) {
        y += coeffs[d] * tmp;
        tmp *= x;
      }
      return y;
    }
};  


float get_split_dist(const TrafficLine& line1, const TrafficLine& line2,
                     float threhold = 0.5);
float get_merge_dist(const TrafficLine& line1, const TrafficLine& line2,
                     float threhold = 0.5);

}
