#include "commom_line.h"

namespace CommuteMode {
namespace MapFusion {
    
TrafficLine::TrafficLine() {Initialize();}
TrafficLine::TrafficLine(const TrafficLine& traffic_line) {
  Reset(traffic_line);
}
TrafficLine::TrafficLine(TrafficLine&& traffic_line) {
  Reset(std::move(traffic_line));
}

void TrafficLine::Initialize() {
//   time_stamp = 0.0;
  id = "";
//   color = ColorType::COLOR_TYPE_UNKNOWN;
  types.clear();
  line_params.clear();
  changable = true;
  index = 0;
//   source = DataSource::DATA_SOURCE_UNKNOWN;
  line_source = "";
  model = LineModel::LINE_MODEL_RAW;
  side_type = SideType::SIDE_TYPE_UNKNOWN;
  line_diversion = LineDiversion::LINE_DIVERSION_UNKNOWN;
  is_ramp = false;
  has_outer = false;
  make_up = false;

  
  type = LineType::LINE_TYPE_UNKNOWN;
  type_sense = LineType::LINE_TYPE_UNKNOWN;
  
  
  
  virtual_line_s.clear();
  conf = 0;
}

void TrafficLine::Reset(const TrafficLine& traffic_line) {
//   time_stamp = traffic_line.time_stamp;
  id = traffic_line.id;
//   color = traffic_line.color;
  changable = traffic_line.changable;
  index = traffic_line.index;
//   source = traffic_line.source;
  line_source = traffic_line.line_source;
  line = traffic_line.line;
  model = traffic_line.model;
  side_type = traffic_line.side_type;
  line_diversion = traffic_line.line_diversion;
  is_ramp = traffic_line.is_ramp;
  has_outer = traffic_line.has_outer;
  types = traffic_line.types;
  line_params = traffic_line.line_params;
  make_up = traffic_line.make_up;

  
  type = traffic_line.type;
  type_sense = traffic_line.type_sense;
  
  
  virtual_line_s = traffic_line.virtual_line_s;
  conf = traffic_line.conf;
}

void TrafficLine::Reset(TrafficLine&& traffic_line) noexcept {
    id = std::move(traffic_line.id);
    changable = std::move(traffic_line.changable);
    index = std::move(traffic_line.index);
    line_source = std::move(traffic_line.line_source);
    line = std::move(traffic_line.line);
    model = std::move(traffic_line.model);
    side_type = std::move(traffic_line.side_type);
    line_diversion = std::move(traffic_line.line_diversion);
    is_ramp = std::move(traffic_line.is_ramp);
    has_outer = std::move(traffic_line.has_outer);
    types = std::move(traffic_line.types);
    line_params = std::move(traffic_line.line_params);
    make_up = std::move(traffic_line.make_up);
    type = std::move(traffic_line.type);
    type_sense = std::move(traffic_line.type_sense);
    virtual_line_s = std::move(traffic_line.virtual_line_s);
    conf = std::move(traffic_line.conf);
}

TrafficLine& TrafficLine::operator= (const TrafficLine& traffic_line) {
  Reset(traffic_line);
  return *this;
}

TrafficLine& TrafficLine::operator= (TrafficLine&& traffic_line) {
  Reset(std::move(traffic_line));
  return *this;
}

float get_merge_dist(const TrafficLine& line1, const TrafficLine& line2, float threhold) {
  float dist = 100000.0;
  if (line1.line.empty() || line2.line.empty()) return dist;
  float line1_starts = line1.line.front().s;
  float line1_ends = line1.line.back().s;
  // float line2_starts = line2.line.front().s;
  // float line2_ends = line2.line.back().s;
  // float x, y, ss, ll, yaw;
  float x = 0.0f, y = 0.0f, ss = 0.0f, ll = 0.0f;
  for (const auto& point:line2.line) {
    if (point.s < 0 || point.s < line1_starts || point.s > line1_ends) continue;
    // x = point.x; y = point.y; yaw = point.yaw;
    x = point.x; y = point.y; 
    line1.line.XYToSL(x, y, NULL, &ss, &ll);
    if (fabsf(ll) < threhold) {
      if(dist > ss) dist = ss;
    }
  }
  return dist;
}


float get_split_dist(const TrafficLine& line1, const TrafficLine& line2, float threhold) {
  float dist = 100000.0;
  if (line1.line.empty() || line2.line.empty()) return dist;
  float line1_starts = line1.line.front().s;
  float line1_ends = line1.line.back().s;
  // float line2_starts = line2.line.front().s;
  // float line2_ends = line2.line.back().s;
  // float x, y, ss, ll, yaw;
  float x = 0.0f, y = 0.0f, ss = 0.0f, ll = 0.0f;
  for (const auto& point:line2.line) {
    if (point.s < 0 || point.s < line1_starts || point.s > line1_ends) continue;
    // x = point.x; y = point.y; yaw = point.yaw;
    x = point.x; y = point.y; 
    line1.line.XYToSL(x, y, NULL, &ss, &ll);
    if (fabsf(ll) > threhold) {
      if(dist > ss) dist = ss;
    }
  }
  return dist;
}



}
}